{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from conventional-git@latest conventional-git check command",
            "if": "Bash(gh pr create*)"
          },
          {
            "type": "command",
            "command": "uvx --from conventional-git@latest conventional-git check command",
            "if": "Bash(gh pr edit*)"
          },
          {
            "type": "command",
            "command": "uvx --from conventional-git@latest conventional-git check command",
            "if": "Bash(bitbucket pr create*)"
          },
          {
            "type": "command",
            "command": "uvx --from conventional-git@latest conventional-git check command",
            "if": "Bash(bitbucket pr update*)"
          }
        ]
      }
    ]
  }
}
